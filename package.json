{
  "name": "piano-kids",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "儿童钢琴启蒙网页应用 — 打开即弹的静态 Web App + PWA",
  "scripts": {
    "dev": "vite",
    "dev:reset": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "icons": "node scripts/generate-icons.mjs",
    "glyphs": "node scripts/extract-bravura-glyphs.mjs",
    "shot": "node scripts/page-shot.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "opentype.js": "2.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
